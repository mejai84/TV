*.ipa
*.jar
*.dex
*.so
*.har

# Salidas de analisis
out-*.txt
out-*.json
_reference/

# Datos de referencia generados
# epg.json son 720 programas sinteticos de prueba: se regenera, no se versiona.
# streams.json SI se versiona: son 3 entradas de demo y hacen que el ejemplo
# funcione nada mas clonar, sin ninguna descarga externa.
web-tv/epg.json
web-tv/es.m3u

# Binarios de terceros vendorizados
# hls.min.js es una dependencia de terceros de 413 KB.
# Se regenera con:
#   mkdir -p web-tv/vendor
#   curl -L -o web-tv/vendor/hls.min.js \
#     https://cdn.jsdelivr.net/npm/hls.js@1.5.13/dist/hls.min.js
web-tv/vendor/

