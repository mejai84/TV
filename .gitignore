# -------------------------------------------------------------------
# Aplicacion web (lo que se despliega)
# -------------------------------------------------------------------

# hls.min.js es una dependencia de terceros de 413 KB.
# Se regenera con:
#   mkdir -p vendor
#   curl -L -o vendor/hls.min.js \
#     https://cdn.jsdelivr.net/npm/hls.js@1.5.13/dist/hls.min.js
vendor/

# Datos generados, no versionados
epg.json
es.m3u

# Vercel
.vercel

# -------------------------------------------------------------------
# Analisis de ingenieria inversa (carpeta analisis/)
# -------------------------------------------------------------------
# No es parte de la aplicacion: no se despliega ni se importa desde el
# codigo. Se ignora entero para que el repositorio contenga solo la app.

analisis/

# Artefactos de las muestras analizadas. Los APK son originales de
# terceros con licencia ajena y no deben publicarse.
*.apk
*.aab
*.ipa
*.jar
*.dex
*.so
*.har
*.pkl

