# Variables de entorno (server-side). Nunca se suben al repositorio.
# En Vercel: Project Settings -> Environment Variables -> Production.

# --- NasriPlay (contenido) ---
NSRPLAY_API_KEY=

# --- TMDB (metadatos: pósteres, años, ids reproducibles) ---
TMDB_API_KEY=

# --- Supabase (Postgres): índice de catálogo y novedades ---
# Crea el proyecto en https://supabase.com y copia desde Project Settings ->
# API. La service key es solo de servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron (opcional): protege /api/scan ---
CRON_SECRET=
